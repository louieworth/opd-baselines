__pycache__/
*.py[cod]
*.so
*.egg-info/

.venv/
.pydeps/
.pytest_cache/
.env
.idea/
.vscode/

# Keep only prepared training and evaluation parquet files under data/.
/data/*
!/data/train/
!/data/eval/
/data/train/*
!/data/train/*.parquet
/data/eval/*
!/data/eval/*.parquet
/MANIFEST.sha256
/models/
/outputs/
/wandb/
/tmp/
tests
# Keep the regression suites for ADOPD and shared training behavior reviewable.
!/tests/
/tests/*
!/tests/test_adopd.py
!/tests/test_training_alignment.py
!/tests/test_opd_response_mask.py
!/tests/test_opd_divergence.py
!/tests/test_gpqa_subsets.py
*.log
.DS_Store
